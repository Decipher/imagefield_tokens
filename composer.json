{
    "name": "drupal/imagefield_tokens",
    "description": "Provides an Image field widget and formatter that supports tokens for Alt and Title attributes.",
    "type": "drupal-module",
    "license": "GPL-2.0-or-later",
    "minimum-stability": "dev",
    "homepage": "https://www.drupal.org/project/imagefield_tokens",
    "authors": [
        {
            "name": "Stuart Clark",
            "homepage": "https://www.drupal.org/u/deciphered",
            "role": "Maintainer"
        },
        {
            "name": "Yaroslav Samoilenko",
            "homepage": "https://www.drupal.org/u/ysamoylenko",
            "role": "Author"
        }
    ],
    "support": {
        "issues": "https://www.drupal.org/project/issues/imagefield_tokens",
        "source": "https://git.drupalcode.org/project/imagefield_tokens"
    },
    "require": {
        "drupal/token": "^1.5",
        "php": ">=8.2"
    },
    "require-dev": {
        "drupal/image_widget_crop": "^3"
    },
    "suggest": {
        "drupal/colorbox": "Optional Colorbox formatter integration",
        "drupal/image_widget_crop": "Optional crop widget integration"
    }
}
